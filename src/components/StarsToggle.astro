---
const translate = Astro.locals.t;
---

<button class="stars-toggle" type="button" aria-label={translate('settings.toggleStars')} aria-pressed="true" title={translate('settings.toggleStars')}>
  <svg
    class="stars-on"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
    <path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" />
  </svg>
  <svg
    class="stars-off"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
    <path d="M3 3l18 18" />
    <path d="M10.012 6.016l1.981 -4.014l3.086 6.253l6.9 1l-4.421 4.304m.012 4.01l.588 3.426l-6.158 -3.245l-6.172 3.245l1.179 -6.873l-5 -4.867l6.327 -.917" />
  </svg>
</button>

<script>
  const key = "au-stars";

  function setStars(on: boolean) {
    document.documentElement.dataset.stars = on ? "on" : "off";
    localStorage.setItem(key, on ? "on" : "off");
    document.querySelectorAll(".stars-toggle").forEach((button) => {
      button.setAttribute("aria-pressed", String(on));
    });
  }

  setStars(localStorage.getItem(key) !== "off");

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest(".stars-toggle")) {
      setStars(document.documentElement.dataset.stars !== "on");
    }
  });
</script>

<style>
  .stars-toggle {
    display: grid;
    place-items: center;
    padding: 0.25rem;
    border: none;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .stars-toggle:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .stars-toggle > svg {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
  }

  .stars-off {
    display: none;
  }

  html[data-stars='off'] .stars-on {
    display: none;
  }

  html[data-stars='off'] .stars-off {
    display: block;
  }
</style>

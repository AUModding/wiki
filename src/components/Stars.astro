---
const layers = [
    { amount: 350, size: 1, speed: 110 },
    { amount: 100, size: 2, speed: 180 },
    { amount: 50, size: 3, speed: 240 },
];

const showGlassPane = Astro.locals.starlightRoute.entry.data.template !== "splash";

function makeStars(amount: number) {
    const stars = [];

    for (let i = 0; i < amount; i++) {
        const x = (Math.random() * 100).toFixed(2);
        const y = (Math.random() * 100).toFixed(2);
        stars.push(`${x}vw ${y}vh`);
    }

    return stars;
}
---

<div class="space" aria-hidden="true">
    <div class="stars">
        {layers.map(({ amount, size, speed }) => {
            const stars = makeStars(amount);
            const mobileStars = stars.slice(0, Math.round(stars.length * 0.35));

            return (
                <div
                    class="layer"
                    style={`
                        --size: ${size}px;
                        --duration: ${speed}s;
                        --stars: ${stars.join(", ")};
                        --stars-mobile: ${mobileStars.join(", ")};
                    `}
                />
            );
        })}
    </div>

    {showGlassPane && <div class="glass-pane" />}
</div>

<style>
    .space {
        position: fixed;
        inset: 0;
        z-index: -10;
        pointer-events: none;
        overflow: hidden;
    }

    .stars {
        position: absolute;
        inset: 0;
    }

    .glass-pane {
        position: absolute;
        inset: 0;
        background: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
    }

    .layer {
        width: var(--size);
        height: var(--size);
        box-shadow: var(--stars);
        animation: drift var(--duration) linear infinite;
    }

    .layer::after {
        content: "";
        position: absolute;
        top: 100vh;
        width: inherit;
        height: inherit;
        box-shadow: inherit;
    }

    @keyframes drift {
        to {
            transform: translateY(-100vh);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .layer {
            animation: none;
        }
    }

    @media (max-width: 768px) {
        .layer,
        .layer::after {
            box-shadow: var(--stars-mobile);
        }
    }
</style>
